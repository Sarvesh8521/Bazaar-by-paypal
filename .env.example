# Copy to .env and fill in. NEVER commit .env.

# PayPal SANDBOX app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: Webhook ID from developer.paypal.com > your app > Webhooks (URL: <PUBLIC_BASE_URL>/api/paypal/webhook)
PAYPAL_WEBHOOK_ID=

# --- AI agents: set ONE of these (first match wins: Anthropic, then Gemini, then OpenAI-compatible) ---
# Nothing set = free offline mock agents (fine for building the UI).

# Option A (FREE, no card): Google Gemini key from https://aistudio.google.com
GEMINI_API_KEY=
# Free-tier model ID, check it in AI Studio. Default is gemini-3.5-flash-lite
BAZAAR_MODEL=

# Option B (paid, very cheap): Anthropic key from console.anthropic.com
ANTHROPIC_API_KEY=

# Option C: any OpenAI-compatible server (Groq, OpenRouter, local Ollama). Also needs BAZAAR_MODEL.
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Force the offline mock agents even if a key is set
MOCK_LLM=0
# Minimum ms between LLM calls (Gemini defaults to 3000 to respect free-tier rate limits)
BAZAAR_LLM_GAP_MS=

# Channel3 product search (used later)
CHANNEL3_API_KEY=

# Where PayPal sends the buyer back to after approval.
#  npm run dev:ui  -> http://localhost:5173   |   npm start -> http://localhost:3000
#  On Render: https://<your-app>.onrender.com
PUBLIC_BASE_URL=http://localhost:5173
# Max sessions / negotiations per IP per hour
RATE_LIMIT_PER_HOUR=30

PORT=3000
