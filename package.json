{
  "name": "bazaar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BAZAAR - AI buyer and seller agents haggle; PayPal settles the deal.",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "test": "tsx --test server/agents.test.ts server/crawl.test.ts server/app.test.ts server/http.test.ts server/doctor.test.ts server/preflight.test.ts src/ui.test.tsx",
    "typecheck": "tsc --noEmit",
    "spike": "tsx scripts/paypal-spike.ts",
    "dev:ui": "vite",
    "build": "vite build",
    "sample": "tsx scripts/export-sample.ts",
    "doctor": "tsx scripts/doctor.ts",
    "preflight": "tsx scripts/preflight.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "framer-motion": "^14.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
